# Render with an explicitly designated Fly app name; this template is never
# deployed directly. This app receives transactional-writer Postgres and R2
# secrets, but has no public HTTP service and no persistent volume. Set the
# non-secret POLYARB_ALERT_CHANNELS=dashboard,telegram here when the isolated
# alert app owns Telegram credentials.
app = "__CONTROL_PLANE_WORKER_APP__"
primary_region = "ams"
# Platform backstop: 30s maximum internal owner plus 10s terminal/interpreter margin.
kill_signal = "SIGTERM"
kill_timeout = 40

[env]
POLYARB_ALERT_CHANNELS = "dashboard,telegram"
POLYARB_DB_POOL_MAX_SIZE = "2"
POLYARB_RUNTIME_ROLE = "control-plane"

[build]

[processes]
coordinator = "python -m polyarb.cli_control_plane serve --enable --worker-id fly-control-plane-coordinator --worker-role coordinator --max-turns 8 --structure-materializer-turns 8 --interval-seconds 2 --json"
structure_range = "/bin/sh -ec 'exec python -m polyarb.cli_control_plane serve --enable --worker-id \"fly-control-plane-structure-range:${FLY_MACHINE_ID:?}\" --worker-role structure-range --pool-turns 2 --interval-seconds 2 --json'"
quote_batch = "python -m polyarb.cli_control_plane serve --enable --worker-id fly-control-plane-quote-batch --worker-role quote-batch --pool-turns 1 --interval-seconds 5 --json"

[[vm]]
size = "shared-cpu-1x"
memory = "1024mb"
processes = ["coordinator", "structure_range", "quote_batch"]
