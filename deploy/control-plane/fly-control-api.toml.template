# Render with an explicitly designated Fly app name; this template is never
# deployed directly. Give this app only a read-only Postgres DSN secret.
app = "__CONTROL_PLANE_API_APP__"
primary_region = "ams"

[build]

[processes]
api = "python -m polyarb.control_plane.api"

[http_service]
internal_port = 8080
force_https = true
auto_stop_machines = "off"
auto_start_machines = true
min_machines_running = 1
processes = ["api"]

  [[http_service.checks]]
  grace_period = "30s"
  interval = "15s"
  method = "GET"
  path = "/healthz"
  timeout = "5s"

[[vm]]
size = "shared-cpu-1x"
memory = "256mb"
processes = ["api"]
