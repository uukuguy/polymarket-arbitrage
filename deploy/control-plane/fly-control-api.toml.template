# Render with an explicitly designated Fly app name; this template is never
# deployed directly. Give this app only a read-only Postgres DSN secret.
app = "__CONTROL_PLANE_API_APP__"
primary_region = "ams"
# Platform backstop: 30s maximum internal owner plus 10s terminal/interpreter margin.
kill_signal = "SIGTERM"
kill_timeout = 40

[env]
POLYARB_DB_POOL_MAX_SIZE = "2"
POLYARB_RUNTIME_ROLE = "control-plane"

[build]

[processes]
api = "python -m polyarb.control_plane.api"

[http_service]
internal_port = 8080
force_https = true
auto_stop_machines = "off"
auto_start_machines = true
# Fly otherwise creates a second HA machine for HTTP services.  This formal
# baseline deliberately has one independently monitored 256MB API instance.
min_machines_running = 0
processes = ["api"]

  [[http_service.checks]]
  # Process liveness only. Strict Postgres readiness is exposed at /health and
  # the independent watchdog reads /perception/control-plane directly.
  grace_period = "30s"
  interval = "15s"
  method = "GET"
  path = "/healthz"
  timeout = "5s"

[[vm]]
size = "shared-cpu-1x"
memory = "256mb"
processes = ["api"]
