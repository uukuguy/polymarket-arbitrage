# Render with an explicitly designated Fly app name. This watchdog has no
# Postgres, HTTP service, data-plane credentials, SQLite volume, Gamma or CLOB
# access. It receives only Telegram credentials and a Fly organization token;
# its code path uses that token only for status reads.
app = "__CONTROL_PLANE_ALERT_APP__"
primary_region = "ams"

[env]
POLYARB_RUNTIME_ROLE = "control-plane"

[build]

[processes]
watchdog = "python -m polyarb.cli_control_plane watchdog-serve --enable --control-api-url https://polyarb-control-api.fly.dev/perception/control-plane --fly-app polyarb-control-worker --machine-id 3d8d0e29c7d589 --machine-id 080d3ddbe66068 --machine-id 4d895231f7d987 --machine-id 85e990c43533e8 --machine-id 86ed91bee33608 --interval-seconds 30 --json"

[[restart]]
policy = "always"

[[vm]]
size = "shared-cpu-1x"
memory = "256mb"
processes = ["watchdog"]
