# Render with an explicitly designated Fly app name. This watchdog has no
# Postgres, HTTP service, data-plane credentials, SQLite volume, Gamma or CLOB
# access. It receives only Telegram credentials and a Fly organization token;
# its code path uses that token only for status reads.
app = "__CONTROL_PLANE_ALERT_APP__"
primary_region = "ams"

[env]
POLYARB_RUNTIME_ROLE = "control-plane"
# These identities are set only after Fly creates the three worker machines.
# They are non-secret deployment facts, never historical template literals.

[build]

[processes]
watchdog = '''/bin/sh -ec 'exec python -m polyarb.cli_control_plane watchdog-serve --enable --control-api-url "$POLYARB_CONTROL_API_URL" --fly-app "$POLYARB_WORKER_APP" --machine-id "$POLYARB_COORDINATOR_MACHINE_ID" --machine-id "$POLYARB_STRUCTURE_RANGE_MACHINE_ID" --machine-id "$POLYARB_QUOTE_BATCH_MACHINE_ID" --secondary-fly-app "$POLYARB_EVIDENCE_APP" --secondary-machine-id "$POLYARB_EVIDENCE_MACHINE_ID" --interval-seconds 30 --json' '''

[[restart]]
policy = "always"

[[vm]]
size = "shared-cpu-1x"
memory = "256mb"
processes = ["watchdog"]
