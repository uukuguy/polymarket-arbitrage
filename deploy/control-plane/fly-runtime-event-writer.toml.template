# Private append-only ledger writer for independent watchdog transitions.
# Give this app only POLYARB_SUPABASE_DB_DSN for the scoped incident-ledger role
# and POLYARB_RUNTIME_EVENT_WRITER_TOKEN. It receives no R2, Gamma, CLOB,
# scheduler, Telegram, or browser credentials.
app = "__RUNTIME_EVENT_WRITER_APP__"
primary_region = "ams"
# Platform backstop: 30s maximum internal owner plus 10s terminal/interpreter margin.
kill_signal = "SIGTERM"
kill_timeout = 40

[env]
POLYARB_DB_POOL_MAX_SIZE = "1"
POLYARB_RUNTIME_ROLE = "control-plane"

[build]

[processes]
writer = "python -m polyarb.control_plane.runtime_event_writer"

[http_service]
internal_port = 8080
force_https = true
auto_stop_machines = "off"
auto_start_machines = true
min_machines_running = 0
processes = ["writer"]

  [[http_service.checks]]
  grace_period = "30s"
  interval = "15s"
  method = "GET"
  path = "/healthz"
  timeout = "5s"

[[vm]]
size = "shared-cpu-1x"
memory = "256mb"
processes = ["writer"]
