# Supabase (browser-side anon-key + RLS; never commit real values)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiI...

# Email whitelist (server-side gate; comma-separated for multi-user)
EMAIL_WHITELIST=your-email@example.com

# /scan HMAC shared secret — BLOCKER-3 fix: VALUE identical to Fly POLYARB_SCAN_SHARED_SECRET,
# but NAME has no POLYARB_ prefix (dashboard does not load pydantic-settings).
SCAN_SHARED_SECRET=

# Fly daemon /scan endpoint
SCAN_ENDPOINT_URL=https://polyarb-l1.fly.dev/scan

# Server-side M1 runtime ledger source. The Dashboard fetches this on the
# server, so it is not exposed as a browser-side NEXT_PUBLIC_ value.
POLYARB_CONTROL_API_URL=https://polyarb-control-api.fly.dev

# Note: SCAN_SHARED_SECRET on the Vercel side must equal the literal value of
# POLYARB_SCAN_SHARED_SECRET on the Fly side (env-var name asymmetry per BLOCKER-3).
# Verify with: flyctl secrets list -a polyarb-l1 → POLYARB_SCAN_SHARED_SECRET digest
# vs Vercel project → Settings → Environment Variables → SCAN_SHARED_SECRET.
