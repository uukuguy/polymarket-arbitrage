# Supabase (browser-side anon-key + RLS; never commit real values)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiI...

# Email whitelist (server-side gate; comma-separated for multi-user)
EMAIL_WHITELIST=your-email@example.com

# /scan HMAC shared secret — BLOCKER-3 fix: VALUE identical to Fly POLYARB_SCAN_SHARED_SECRET,
# but NAME has no POLYARB_ prefix (dashboard does not load pydantic-settings).
SCAN_SHARED_SECRET=

# Fly daemon /scan endpoint
SCAN_ENDPOINT_URL=https://polyarb-l1.fly.dev/scan
