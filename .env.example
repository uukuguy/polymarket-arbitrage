# Polyarb Phase 1.1 — Translation API
# Copy to .env and fill in your values. See docs/learning/07-观察市场.md for setup.
#
# This project does NOT bind to any single LLM vendor — any OpenAI-compatible
# endpoint works (DeepSeek / Qwen / OpenAI / self-hosted vLLM / ...).
#
# First-run flow:
#   1. cp .env.example .env  &&  edit values
#   2. make translate-pending-sample   (limit 50, dry-run to verify)
#   3. make translate-pending FORCE=1  (bulk-translate everything else)
#
# Required:
TRANSLATION_API_BASE=https://api.deepseek.com/v1
TRANSLATION_API_KEY=sk-your-key-here
TRANSLATION_MODEL=deepseek-chat

# Optional — DeepSeek 免费档建议 3-5；付费档 10。If you hit rate limits, lower this.
TRANSLATION_MAX_CONCURRENCY=10

# Supabase (Plan 03) — W6 fix: TWO distinct env vars
# POLYARB_SUPABASE_URL is the REST URL used by supabase-py (https://<ref>.supabase.co)
# POLYARB_SUPABASE_DB_DSN is the Postgres DSN used ONLY by alembic (postgresql://...)
POLYARB_SUPABASE_URL=
POLYARB_SUPABASE_DB_DSN=
POLYARB_SUPABASE_SERVICE_KEY=

# Cloudflare R2 (Plan 03)
POLYARB_R2_ENDPOINT=
POLYARB_R2_ACCESS_KEY_ID=
POLYARB_R2_SECRET_ACCESS_KEY=
POLYARB_R2_BUCKET=polyarb-snapshots

# Fly.io (Plan 04 — deploy)
# GHA secret: FLY_API_TOKEN (created via: flyctl tokens create deploy -a polyarb-l1)

# Observability (Plan 05 — D-14/D-15/D-16/D-17)
# Empty values are valid for local dev (init_sentry / Better Stack / Telegram
# all skip cleanly when their config is empty). In prod, all six are set via
# `flyctl secrets set` (see Task 4 checkpoint in 02-05-PLAN.md).
POLYARB_SENTRY_DSN=
POLYARB_AXIOM_TOKEN=
POLYARB_AXIOM_DATASET=polyarb-prod
POLYARB_BETTER_STACK_HEARTBEAT_URL=
POLYARB_TELEGRAM_BOT_TOKEN=
POLYARB_TELEGRAM_CHAT_ID=
# Dedup window in seconds: a paused-alert fired twice within this window
# counts as one (suppresses storm during flaky-network periods).
POLYARB_ALERT_DEDUPE_WINDOW_SECONDS=300

# Opportunity-first Candidate Watcher (Task 2; remains disabled until rollout)
# The first high group is served before lower lanes. The 30s timeout × burst 1
# must stay strictly below the explicit normal-candidate 120s acceptance bound.
# At least ceil(20%) of each cycle is reserved for normal/explore work.
POLYARB_OPPORTUNITY_FIRST_WATCHER_ENABLED=false
POLYARB_CANDIDATE_CYCLE_MAX_GROUPS=12
POLYARB_CANDIDATE_RESERVED_NON_HIGH_SLOTS=3
POLYARB_CANDIDATE_GROUP_TIMEOUT_S=30
POLYARB_CANDIDATE_HIGH_BURST_GROUPS=1
POLYARB_CANDIDATE_LOWER_LANE_MAX_WAIT_S=120
POLYARB_CANDIDATE_HIGH_CLOB_WORKERS=2
POLYARB_CANDIDATE_LOWER_CLOB_WORKERS=1
# Discovery stays dark until production qualification. These budgets form the
# conservative <=60s first-start proof; SQLite write budgets cannot be <5s.
POLYARB_OPPORTUNITY_DISCOVERY_ENABLED=false
POLYARB_DISCOVERY_CANDIDATE_MAX_WAIT_S=60
POLYARB_CANDIDATE_SCHEDULER_POLL_S=1
POLYARB_CANDIDATE_SELECTION_BUDGET_S=6
POLYARB_CANDIDATE_TERMINAL_WRITE_BUDGET_S=5
POLYARB_CANDIDATE_ATTEMPT_START_WRITE_BUDGET_S=5

# Full Reconciliation is a low-priority, checkpointed calibration producer.
# It and the old universe-sized Structure loop are independently default-off.
POLYARB_OPPORTUNITY_RECONCILIATION_ENABLED=false
POLYARB_RECONCILIATION_PAGE_LIMIT=100
POLYARB_RECONCILIATION_INTERVAL_S=60
POLYARB_RECONCILIATION_CHECKPOINT_WARN_S=900
POLYARB_LEGACY_STRUCTURE_RECONCILIATION_ENABLED=false
