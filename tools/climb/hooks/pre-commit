#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

SOURCE_RE='^docs/status/climb/(hypotheses\.yaml|runs\.csv|calibration\.json|pending-lb\.json|session-state\.json|config\.yaml|session-target\.md)$'
TREE_MD='docs/status/climb/research-tree.md'
TREE_JSON='docs/status/climb/research-tree.json'

STAGED=$(git diff --cached --name-only --diff-filter=ACMRD)
if ! printf '%s\n' "$STAGED" | grep -Eq "$SOURCE_RE"; then
  exit 0
fi

if ! python3 tools/climb/regen-tree.py; then
  echo "climb tree check: generator failed; commit was not modified" >&2
  exit 1
fi

if ! git diff --quiet -- "$TREE_MD" "$TREE_JSON"; then
  echo "climb tree check: generated research tree must be reviewed and staged" >&2
  echo "git add $TREE_MD $TREE_JSON && retry commit" >&2
  exit 1
fi

exit 0
