{
  "name": "polyarb-control-watchdog-supervisor",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "workers_dev": false,
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [
    { "binding": "WATCHDOG_STATE", "id": "e78344e0d6f246578b5eeccb41034525" }
  ],
  "vars": {
    "FLY_ALERT_APP": "polyarb-control-alert",
    "FLY_ALERT_MACHINE_ID": "d891e941a41dd8",
    "RUNTIME_EVENT_WRITER_URL": "https://polyarb-control-runtime-event-writer.fly.dev",
    "RUNTIME_EVENT_SOURCE": "cloudflare-watchdog-supervisor"
  }
}
