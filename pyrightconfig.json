{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "include": ["src", "tests", "scripts"],
  "extraPaths": ["src"],
  "exclude": [
    "**/__pycache__",
    ".venv",
    "data",
    "3th-party",
    ".planning",
    ".claude/worktrees"
  ],
  "reportMissingImports": "error",
  "reportUnusedImport": "warning",
  "reportUnusedVariable": "none",
  "reportUnusedFunction": "none"
}
