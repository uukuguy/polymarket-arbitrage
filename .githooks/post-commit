#!/usr/bin/env bash
set -euo pipefail

if [[ "${CLIMB_REGEN_ACTIVE:-0}" == "1" ]]; then
  exit 0
fi

CHANGED="$(git diff-tree --no-commit-id --name-only -r HEAD)"
if ! printf '%s\n' "$CHANGED" | grep -qE '^docs/status/climb/(hypotheses.yaml|runs.csv|calibration.json|pending-lb.json|session-state.json)$'; then
  exit 0
fi
if printf '%s\n' "$CHANGED" | grep -qE '^docs/status/climb/research-tree\.(md|json)$'; then
  exit 0
fi

uv run python tools/climb/regen-tree.py >/dev/null
git add docs/status/climb/research-tree.md docs/status/climb/research-tree.json
CLIMB_REGEN_ACTIVE=1 git commit --amend --no-edit --no-verify >/dev/null
echo "[post-commit] regenerated climb research tree" >&2
