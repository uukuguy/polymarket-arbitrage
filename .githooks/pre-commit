#!/usr/bin/env bash
# pre-commit hook — staged-content and planning safety checks.
# Subject-dependent SUMMARY enforcement lives in commit-msg, where Git has
# reliably supplied the proposed commit message.

set -euo pipefail

# Keep the M1 product/operations manual synchronized with public contracts.
uv run python scripts/check_m1_manual.py --staged

# Climb state is rendered before commit. When derived bytes change the helper
# fails so the regenerated projections can be reviewed and staged explicitly.
tools/climb/hooks/pre-commit

# SUMMARY files are durable planning anchors. Refuse staged deletion and empty
# staged summaries here, independent of the eventual subject line.
while IFS= read -r summary; do
  [ -n "$summary" ] || continue
  printf '\n\033[31m✗ pre-commit BLOCKED\033[0m\n' >&2
  printf '  Staged SUMMARY deletion: %s\n' "$summary" >&2
  printf '  Archive or replace the planning anchor explicitly before committing.\n\n' >&2
  exit 1
done < <(git diff --cached --name-only --diff-filter=D -- '*-SUMMARY.md')

while IFS= read -r summary; do
  [ -n "$summary" ] || continue
  if [ -z "$(git show ":$summary" 2>/dev/null)" ]; then
    printf '\n\033[31m✗ pre-commit BLOCKED\033[0m\n' >&2
    printf '  Staged SUMMARY is empty: %s\n\n' "$summary" >&2
    exit 1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*-SUMMARY.md')

exit 0
